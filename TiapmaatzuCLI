@cli.command("list-souls")
@click.option("--rarity", type=click.Choice(["Common", "Rare", "Legendary"]), default=None)
@click.option("--tier", type=click.Choice(["upper", "second"]), default=None)
@click.option("--platform", default=None)
@click.option("--archetype", default=None)
@click.pass_obj
def cmd_list_souls(cli_obj: TiapmaatzuCLI, rarity, tier, platform, archetype):
    filters = {}
    if rarity: filters["rarity"] = rarity
    if tier: filters["tier"] = tier
    if platform: filters["platform"] = platform
    if archetype: filters["archetype"] = archetype
    souls = cli_obj.get_souls(filters)
    click.echo(f"\n{'ID':<10} {'Name':<20} {'Archetype':<20} {'Rarity':<10} {'Tier':<6}")
    click.echo("-" * 66)
    for s in souls:
        click.echo(f"{s.id:<10} {s.name:<20} {s.archetype:<20} {s.rarity:<10} {s.tier:<6}")
    click.echo(f"\nTotal: {len(souls)} souls")


