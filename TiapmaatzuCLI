def ensure_initialized(*attrs: str):
    """
    Decorator to ensure specified attributes are initialized on self.
    It expects initializer methods named `initialize_<attr>` to exist.
    Usage:
        @ensure_initialized("souls_manager")
        def some_method(self, ...):
            ...
    """
    def decorator(func: Callable):
        def wrapper(self, *args, **kwargs):
            for attr in attrs:
                if getattr(self, attr) is None:
                    init_name = f"initialize_{attr}"
                    init = getattr(self, init_name, None)
                    if not callable(init):
                        raise RuntimeError(f"Missing initializer: {init_name}")
                    init()
            return func(self, *args, **kwargs)
        wrapper.__name__ = func.__name__
        wrapper.__doc__ = func.__doc__
        return wrapper
    return decorator


class TiapmaatzuCLI:
    """Encapsulates platform operations. Methods either return data or perform actions."""

    def __init__(self, base_data_dir: Optional[Path] = None):
        self.base_data_dir = Path(base_data_dir) if base_data_dir else Path(__file__).parent / "src" / "data"
        self.souls_manager: Optional[SoulsManager] = None
        self.cashinghouse: Optional[CashingHouse] = None
        self.financial_integration: Optional[SoulsFinancialIntegration] = None
        self.analytics_dashboard: Optional[AnalyticsDashboard] = None

    # -----------------------
    # Initialization methods
    # -----------------------
    def initialize_souls_manager(self, data_path: Optional[str] = None):
        if data_path:
            data_file = Path(data_path)
        else:
            data_file = self.base_data_dir / "souls_entities.json"
        self.souls_manager = SoulsManager(str(data_file))
        logger.info("SoulsManager initialized (%d souls)", len(self.souls_manager.get_all_souls()))

    def initialize_cashinghouse(self, data_path: Optional[str] = None):
        if data_path:
            data_file = Path(data_path)
        else:
            data_file = self.base_data_dir.parent / "data" / "cashinghouse.json"
        self.cashinghouse = CashingHouse(str(data_file))
        logger.info("CashingHouse initialized (%d transactions)", len(self.cashinghouse.transactions))

    def initialize_financial_integration(self):
        if not self.souls_manager:
            self.initialize_souls_manager()
        self.financial_integration = SoulsFinancialIntegration(self.souls_manager)
        logger.info("Financial integration initialized")

    def initialize_analytics_dashboard(self):
        if not self.souls_manager:
            self.initialize_souls_manager()
        if not self.cashinghouse:
            self.initialize_cashinghouse()
        if not self.financial_integration:
            self.initialize_financial_integration()
        self.analytics_dashboard = AnalyticsDashboard(
            souls_manager=self.souls_manager,
            cashinghouse=self.cashinghouse,
            financial_integration=self.financial_integration,
        )
        logger.info("AnalyticsDashboard initialized")

    # -----------------------
    # Helpers
    # -----------------------
    def _lookup_soul(self, identifier: str):
        """Find soul by id or name (returns None if not found)."""
        if not self.souls_manager:
            self.initialize_souls_manager()
        s = self.souls_manager.get_soul_by_id(identifier)
        if s:
            return s
        return self.souls_manager.get_soul_by_name(identifier)

    def _safe_create_backup(self) -> Optional[str]:
        """Public wrapper that prefers a public API if available, otherwise falls back."""
        if not self.souls_manager:
            self.initialize_souls_manager()
        create_public = getattr(self.souls_manager, "create_backup", None)
        if callable(create_public):
            return create_public()
        # last resort: protected method (keep for backward compatibility)
        protected = getattr(self.souls_manager, "_create_backup", None)
        if callable(protected):
            logger.warning("Using protected backup method _create_backup; consider exposing create_backup()")
            return protected()
        logger.error("No backup method found on SoulsManager")
        return None

    # -----------------------
    # Core actions (return data)
    # -----------------------
    @ensure_initialized("souls_manager")
    def get_souls(self, filters: Optional[dict] = None) -> List[Any]:
        souls = self.souls_manager.get_all_souls()
        if not filters:
            return souls
        if 'rarity' in filters:
            souls = [s for s in souls if s.rarity == filters['rarity']]
        if 'tier' in filters:
            souls = [s for s in souls if s.tier == filters['tier']]
        if 'platform' in filters:
            souls = [s for s in souls if filters['platform'] in getattr(s, "platforms", [])]
        if 'archetype' in filters:
            souls = [s for s in souls if s.archetype == filters['archetype']]
        return souls

    @ensure_initialized("souls_manager")
    def get_soul_details(self, soul_id: str) -> Optional[Any]:
        return self._lookup_soul(soul_id)

    @ensure_initialized("souls_manager")
    def get_statistics(self) -> dict:
        return self.souls_manager.get_statistics()

    @ensure_initialized("souls_manager")
    def get_compatible_souls(self, soul_id: str, threshold: float = 50.0) -> List[Tuple[Any, float]]:
        target = self._lookup_soul(soul_id)
        if not target:
            raise ValueError(f"Soul not found: {soul_id}")
        return self.souls_manager.find_compatible_souls(target.id, threshold)

    @ensure_initialized("souls_manager")
    def add_platform(self, soul_id: str, platform: str) -> bool:
        success = self.souls_manager.add_platform_to_soul(soul_id, platform)
        if success:
            self.souls_manager.save_souls_data()
        return success

    @ensure_initialized("souls_manager")
    def remove_platform(self, soul_id: str, platform: str) -> bool:
        success = self.souls_manager.remove_platform_from_soul(soul_id, platform)
        if success:
            self.souls_manager.save_souls_data()
        return success

    @ensure_initialized("souls_manager")
    def analyze_interaction(self, soul_id1: str, soul_id2: str, interaction_type: str) -> dict:
        return self.souls_manager.create_soul_interaction(soul_id1, soul_id2, interaction_type)

    @ensure_initialized("souls_manager")
    def get_trending_platforms(self, limit: int = 5) -> List[dict]:
        return self.souls_manager.get_trending_platforms(limit)

    @ensure_initialized("souls_manager")
    def data_integrity_report(self) -> dict:
        return self.souls_manager.get_data_integrity_report()

    @ensure_initialized("souls_manager")
    def list_backups(self) -> List[dict]:
        return self.souls_manager.list_backups()

    def create_backup(self) -> Optional[str]:
        return self._safe_create_backup()

    @ensure_initialized("cashinghouse")
    def add_transaction(self, transaction_type: str, category: str, amount: float, description: str) -> Any:
        # Validate enum construction; let CashingHouse raise ValueError if invalid
        tx = self.cashinghouse.add_transaction(
            transaction_type=TransactionType(transaction_type),
            category=TransactionCategory(category),
            amount=amount,
            description=description,
        )
        return tx

    @ensure_initialized("cashinghouse")
    def financial_summary(self) -> Any:
        return self.cashinghouse.get_financial_summary()

    @ensure_initialized("financial_integration")
    def record_tribute(self, soul_id: str, tribute_type: str, amount: Optional[float], description: str, impact_area: str) -> Any:
        tribute = self.financial_integration.record_tribute(
            soul_id=soul_id,
            tribute_type=TributeType(tribute_type),
            amount=amount,
            description=description,
            impact_area=impact_area,
        )
        return tribute

    @ensure_initialized("financial_integration")
    def humant_terry_health(self) -> dict:
        # renamed variable-safe method (no hyphens in names)
        return self.financial_integration.calculate_HueMan_i_Terry_financial_health()

    @ensure_initialized("analytics_dashboard")
    def platform_analytics(self) -> dict:
        return self.analytics_dashboard.get_platform_usage_analytics()

    @ensure_initialized("analytics_dashboard")
    def financial_analytics(self, days: int = 30) -> dict:
        return self.analytics_dashboard.get_financial_health_analytics(days=days)

    @ensure_initialized("analytics_dashboard")
    def soul_performance(self) -> dict:
        return self.analytics_dashboard.get_soul_performance_analytics()

    @ensure_initialized("analytics_dashboard")
    def comprehensive_dashboard(self) -> dict:
        return self.analytics_dashboard.get_comprehensive_dashboard()


# -----------------------
# CLI wiring (Click)
# -----------------------

@click.group(context_settings={"help_option_names": ["-h", "--help"]})
@click.option("--data-dir", type=click.Path(path_type=Path), default=None,
              help="Path to data directory (used in development).")
@click.pass_context
def cli(ctx: click.Context, data_dir: Optional[Path]):
    """Tiapma'atzu Platform CLI (refactored)."""
    ctx.obj = TiapmaatzuCLI(base_data_dir=data_dir)


# Simple dispatch map for programmatic usage or generic 'run' command.
# Keys are short command names; values are callables that accept (cli_obj, **kwargs).
_DISPATCH_MAP: Dict[str, Callable[[TiapmaatzuCLI, dict], Any]] = {
    "list-souls": lambda c, p: c.get_souls(p.get("filters")),
    "show-soul": lambda c, p: c.get_soul_details(p["soul_id"]),
    "statistics": lambda c, p: c.get_statistics(),
    "compatibility": lambda c, p: c.get_compatible_souls(p["soul_id"], p.get("threshold", 50.0)),
    "add-platform": lambda c, p: c.add_platform(p["soul_id"], p["platform"]),
    "remove-platform": lambda c, p: c.remove_platform(p["soul_id"], p["platform"]),
    "soul-interaction": lambda c, p: c.analyze_interaction(p["soul_id1"], p["soul_id2"], p["interaction_type"]),
    "trending-platforms": lambda c, p: c.get_trending_platforms(p.get("limit", 5)),
    "data-integrity": lambda c, p: c.data_integrity_report(),
    "list-backups": lambda c, p: c.list_backups(),
    "create-backup": lambda c, p: c.create_backup(),
    "add-transaction": lambda c, p: c.add_transaction(p["type"], p["category"], p["amount"], p["description"]),
    "financial-summary": lambda c, p: c.financial_summary(),
    "record-tribute": lambda c, p: c.record_tribute(p["soul_id"], p["type"], p.get("amount"), p["description"], p["impact_area"]),
    "HueMan-i-Terry-health": lambda c, p: c.humant_terry_health(),
    "platform-analytics": lambda c, p: c.platform_analytics(),
    "financial-analytics": lambda c, p: c.financial_analytics(p.get("days", 30)),
    "soul-performance": lambda c, p: c.soul_performance(),
    "comprehensive-dashboard": lambda c, p: c.comprehensive_dashboard(),
}


