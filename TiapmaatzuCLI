@cli.command("compatibility")
@click.argument("soul_id")
@click.option("--threshold", type=float, default=50.0)
@click.pass_obj
def cmd_compatibility(cli_obj: TiapmaatzuCLI, soul_id, threshold):
    try:
        compatible = cli_obj.get_compatible_souls(soul_id, threshold)
    except ValueError as e:
        click.echo(f"❌ {e}", err=True)
        raise click.Abort()
    click.echo(f"\n{'='*60}")
    click.echo(f"Compatible Souls for {soul_id} (Threshold: {threshold}%)")
    click.echo(f"{'='*60}")
    if not compatible:
        click.echo(f"No compatible souls found above {threshold}% threshold")
        return
    click.echo(f"\n{'Name':<20} {'Archetype':<20} {'Score':<10}")
    click.echo("-" * 50)
    for soul, score in compatible:
        click.echo(f"{soul.name:<20} {soul.archetype:<20} {score:<10.1f}")
    click.echo(f"\nTotal: {len(compatible)} compatible souls")


