# Provide a programmatic runner that uses the dispatch map (useful for tests)
def run_command_by_name(cli_obj: TiapmaatzuCLI, command: str, params: dict = None):
    params = params or {}
    if command not in _DISPATCH_MAP:
        raise KeyError(f"Unknown command: {command}")
    return _DISPATCH_MAP[command](cli_obj, params)


